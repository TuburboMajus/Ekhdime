# ==========================================================================
# Whisper ASR Webservice -- component environment
#
# Every variable below is documented and verified against the real upstream
# project (ahmetoner/whisper-asr-webservice) at the pinned version, v1.10.0:
#   - docs/environmental-variables.md
#   - app/config.py (the actual os.getenv() calls read at runtime)
# No variables are invented; anything not read by app/config.py is left out.
# ==========================================================================

# Image tag, also recorded in ../config/versions.env. Do not use `latest`.
# https://hub.docker.com/r/onerahmet/openai-whisper-asr-webservice/tags
WHISPER_ASR_VERSION=v1.10.0

# ASR engine. Upstream supports: openai_whisper | faster_whisper | whisperx
# (app/config.py: ASR_ENGINE = os.getenv("ASR_ENGINE", "openai_whisper")).
# This repo's root README explicitly wants faster-whisper as the default
# engine (better CPU performance/lower memory than openai_whisper), so the
# default here is overridden to faster_whisper rather than upstream's own
# default.
ASR_ENGINE=faster_whisper

# Whisper model size. Verified valid values (docs/environmental-variables.md):
#   tiny, base, small, medium, large-v1, large-v2, large-v3 (or large),
#   large-v3-turbo (or turbo)
#   English-optimized: tiny.en, base.en, small.en, medium.en
#   Distilled (faster_whisper/whisperx only): distil-large-v2,
#   distil-medium.en, distil-small.en, distil-large-v3
# Upstream's own default is "base"; this repo defaults to "small" as a
# better accuracy/resource trade-off for CPU deployments (see README.md
# "Resource expectations" for approximate RAM per size). CPU deployment
# must work with this default -- verified by actually running the
# container with ASR_ENGINE=faster_whisper and ASR_MODEL=tiny (a smaller
# model, to keep the verification run fast) with no GPU present.
ASR_MODEL=small

# Optional override for where model files are stored/loaded from inside the
# container. Leave blank to use the library defaults (which is what ends up
# under /root/.cache -- see the `whisper-cache` volume in docker-compose.yml).
# app/config.py: MODEL_PATH = os.getenv("ASR_MODEL_PATH", "~/.cache/whisper").
ASR_MODEL_PATH=

# Compute device: cuda | cpu. Upstream defaults to "cuda" automatically if a
# GPU is visible to the container, otherwise "cpu"
# (app/config.py: os.getenv("ASR_DEVICE", "cuda" if torch.cuda.is_available() else "cpu")).
# Set explicitly to "cpu" here so the standalone/default stack never
# silently tries to use a GPU that docker-compose.gpu.yml hasn't reserved.
ASR_DEVICE=cpu

# Model weight precision: float32 | float16 | int8. Upstream defaults to
# float32 on GPU and int8 on CPU (app/config.py). int8 is fastest/lightest
# and the right choice for the default CPU deployment; docker-compose.gpu.yml
# overrides this to float16 for GPU runs.
ASR_QUANTIZATION=int8

# Seconds of inactivity after which the loaded model is unloaded from memory
# (0 disables unloading and keeps the model resident indefinitely). Upstream
# default is 0 (app/config.py: MODEL_IDLE_TIMEOUT = int(os.getenv(..., 0))).
MODEL_IDLE_TIMEOUT=0

# Expected audio sample rate in Hz for input audio. Upstream default is
# 16000, standard for speech-to-text (app/config.py: SAMPLE_RATE).
SAMPLE_RATE=16000

# Hugging Face access token. Only required/used when ASR_ENGINE=whisperx,
# to download the speaker-diarization model (app/config.py logs a warning
# if ASR_ENGINE=whisperx and this is empty). Not needed for the
# faster_whisper engine this repo defaults to. Leave blank unless you
# switch ASR_ENGINE to whisperx.
HF_TOKEN=
