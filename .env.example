# ==========================================================================
# Plane MCP Voice Assistant -- root environment
#
# This is the SINGLE .env file used when running the full stack from the
# repository root (`make bootstrap`, `make plane-up`, `make up`). Every
# component's own docker-compose.yml also has its own .env.example for
# standalone use (`cd gateway && docker compose up`) -- see each
# component's README.md. The variable names here match those files exactly
# so `docker compose --env-file .env` (what the Makefile does under the
# hood) satisfies every included compose file at once.
#
# Copy to .env and fill in the blanks. `make bootstrap` will do this for you
# and generate a random GATEWAY_API_TOKEN.
# ==========================================================================


# ==========================================================================
# Plane (see plane/README.md for the two-phase bootstrap this requires)
# ==========================================================================

APP_DOMAIN=localhost
APP_RELEASE=v1.4.2

WEB_REPLICAS=1
SPACE_REPLICAS=1
ADMIN_REPLICAS=1
API_REPLICAS=1
WORKER_REPLICAS=1
BEAT_WORKER_REPLICAS=1
LIVE_REPLICAS=1

# Only Plane's UI needs to be reachable from outside Docker.
LISTEN_HTTP_PORT=8080
LISTEN_HTTPS_PORT=8443

WEB_URL=http://localhost:8080
DEBUG=0
CORS_ALLOWED_ORIGINS=
API_BASE_URL=http://api:8000

PGHOST=plane-db
PGDATABASE=plane
POSTGRES_USER=plane
POSTGRES_PASSWORD=plane
POSTGRES_DB=plane
POSTGRES_PORT=5432
PGDATA=/var/lib/postgresql/data
DATABASE_URL=

REDIS_HOST=plane-redis
REDIS_PORT=6379
REDIS_URL=

RABBITMQ_HOST=plane-mq
RABBITMQ_PORT=5672
RABBITMQ_USER=plane
RABBITMQ_PASSWORD=plane
RABBITMQ_VHOST=plane
AMQP_URL=

CERT_ACME_CA=https://acme-v02.api.letsencrypt.org/directory
TRUSTED_PROXIES=0.0.0.0/0
SITE_ADDRESS=:80
CERT_EMAIL=
CERT_ACME_DNS=

# MUST change before any non-local deployment. Generate with: openssl rand -hex 32
SECRET_KEY=change-this-key-on-deployment
LIVE_SERVER_SECRET_KEY=change-this-key-on-deployment

USE_MINIO=1
AWS_REGION=
AWS_ACCESS_KEY_ID=access-key
AWS_SECRET_ACCESS_KEY=secret-key
AWS_S3_ENDPOINT_URL=http://plane-minio:9000
AWS_S3_BUCKET_NAME=uploads
FILE_SIZE_LIMIT=5242880
# minio/minio on Docker Hub now requires auth for anonymous pulls; see
# plane/README.md "Deviations from upstream" -- we use the quay.io mirror.
MINIO_VERSION=RELEASE.2025-09-07T16-13-09Z

GUNICORN_WORKERS=1
MINIO_ENDPOINT_SSL=0
API_KEY_RATE_LIMIT=60/minute
AUTHENTICATION_RATE_LIMIT=10/minute
WEBHOOK_ALLOWED_IPS=
WEBHOOK_ALLOWED_HOSTS=

# --- Filled in AFTER Phase 1 (creating a workspace in the Plane UI) ---
# See plane/README.md "Two-phase bootstrap".
PLANE_WORKSPACE_SLUG=
PLANE_API_KEY=
PLANE_USER_EMAIL=


# ==========================================================================
# Plane MCP server (see plane-mcp/README.md)
# ==========================================================================

PLANE_MCP_VERSION=v0.3.2
PLANE_INTERNAL_BASE_URL=http://api:8000
PLANE_BASE_URL=
MCP_PATH_PREFIX=
LOG_USER_INFO=false
LOG_PAYLOADS=false
# Required for the process to start (unused OAuth transport) -- see
# plane-mcp/README.md. Non-secret placeholders; do not put real OAuth
# credentials here.
PLANE_OAUTH_PROVIDER_CLIENT_ID=unused
PLANE_OAUTH_PROVIDER_CLIENT_SECRET=unused
PLANE_OAUTH_PROVIDER_BASE_URL=http://localhost:8211
# Debug-only: publishes the MCP port to the host. Keep false normally.
PLANE_MCP_EXPOSE_PORT=false
PLANE_MCP_HOST_PORT=8100


# ==========================================================================
# Gateway (see gateway/README.md and gateway/API.md)
# ==========================================================================

ENVIRONMENT=development
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8088
# MUST be a strong random value outside development -- the gateway refuses
# to start with this default when ENVIRONMENT=production.
# Generate with: openssl rand -hex 32
GATEWAY_API_TOKEN=change-me

# copilot | claude
AGENT_CLI=copilot
AGENT_TIMEOUT_SECONDS=180
AGENT_MAX_CONCURRENT_REQUESTS=2
COPILOT_CLI_VERSION=1.0.83
CLAUDE_CODE_VERSION=2.1.270

LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com/anthropic
LLM_API_KEY=
LLM_MODEL=deepseek-v4-pro

PLANE_PUBLIC_URL=http://localhost:8080
PLANE_MCP_URL=http://plane-mcp:8211/http/api-key/mcp

CONVERSATION_CONTEXT_MESSAGES=10
DATABASE_URL=sqlite+aiosqlite:////data/gateway.db

MAX_AUDIO_SIZE_MB=25
MAX_AUDIO_DURATION_SECONDS=300

TTS_CACHE_TTL_SECONDS=3600
TTS_CACHE_MAX_MB=500

LOG_LEVEL=INFO
LOG_REQUEST_CONTENT=false


# ==========================================================================
# Speech-to-text (see speech-stt/README.md)
# ==========================================================================

WHISPER_ASR_VERSION=v1.10.0
STT_URL=http://speech-stt:9000
ASR_ENGINE=faster_whisper
ASR_MODEL=small
ASR_MODEL_PATH=
ASR_DEVICE=cpu
ASR_QUANTIZATION=int8
MODEL_IDLE_TIMEOUT=0
SAMPLE_RATE=16000
HF_TOKEN=
# Leave blank for automatic language detection; overridable per-request.
STT_LANGUAGE=


# ==========================================================================
# Text-to-speech (see speech-tts/README.md)
# ==========================================================================

KOKORO_FASTAPI_VERSION=v0.9.0
TTS_URL=http://speech-tts:8880
TTS_MODEL=kokoro
TTS_VOICE=af_heart
TTS_FORMAT=mp3
TTS_SPEED=1.0
