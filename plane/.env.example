# ==========================================================================
# Plane Community Edition -- component environment
#
# This mirrors the official `variables.env` shipped with the Plane release
# (https://github.com/makeplane/plane/releases/download/<tag>/variables.env),
# with two changes: LISTEN_HTTP_PORT/LISTEN_HTTPS_PORT default to 8080/8443
# instead of 80/443 (so this stack does not need root/CAP_NET_BIND_SERVICE),
# and an added MINIO_VERSION (see docker-compose.yml for why).
#
# Copy to .env and edit before running `docker compose up` in this directory,
# or let the repo-root `make bootstrap` generate it for you as part of the
# full stack.
# ==========================================================================

APP_DOMAIN=localhost
APP_RELEASE=v1.4.2

WEB_REPLICAS=1
SPACE_REPLICAS=1
ADMIN_REPLICAS=1
API_REPLICAS=1
WORKER_REPLICAS=1
BEAT_WORKER_REPLICAS=1
LIVE_REPLICAS=1

# Host ports for the Plane UI (proxy container). This is the only Plane port
# that needs to be reachable outside the Docker network.
LISTEN_HTTP_PORT=8080
LISTEN_HTTPS_PORT=8443

WEB_URL=http://localhost:8080
DEBUG=0
CORS_ALLOWED_ORIGINS=
API_BASE_URL=http://api:8000

# --- Postgres ---
PGHOST=plane-db
PGDATABASE=plane
POSTGRES_USER=plane
POSTGRES_PASSWORD=plane
POSTGRES_DB=plane
POSTGRES_PORT=5432
PGDATA=/var/lib/postgresql/data
DATABASE_URL=

# --- Redis (Valkey) ---
REDIS_HOST=plane-redis
REDIS_PORT=6379
REDIS_URL=

# --- RabbitMQ ---
RABBITMQ_HOST=plane-mq
RABBITMQ_PORT=5672
RABBITMQ_USER=plane
RABBITMQ_PASSWORD=plane
RABBITMQ_VHOST=plane
AMQP_URL=

# --- TLS (only used if you let the proxy container terminate TLS itself;
#     see plane/README.md and the root README's TLS section for the
#     recommended alternative of a shared reverse proxy) ---
CERT_ACME_CA=https://acme-v02.api.letsencrypt.org/directory
TRUSTED_PROXIES=0.0.0.0/0
SITE_ADDRESS=:80
CERT_EMAIL=
CERT_ACME_DNS=

# Django secret key -- MUST be changed before any non-local deployment.
# Generate with: openssl rand -hex 32
SECRET_KEY=change-this-key-on-deployment

# --- Object storage (MinIO, S3-compatible) ---
USE_MINIO=1
AWS_REGION=
AWS_ACCESS_KEY_ID=access-key
AWS_SECRET_ACCESS_KEY=secret-key
AWS_S3_ENDPOINT_URL=http://plane-minio:9000
AWS_S3_BUCKET_NAME=uploads
FILE_SIZE_LIMIT=5242880
# Pinned because the `minio/minio` Docker Hub image now requires
# authentication for anonymous pulls; quay.io/minio/minio is the mirror we use.
MINIO_VERSION=RELEASE.2025-09-07T16-13-09Z

GUNICORN_WORKERS=1
MINIO_ENDPOINT_SSL=0

API_KEY_RATE_LIMIT=60/minute
AUTHENTICATION_RATE_LIMIT=10/minute

# Live collaboration server secret -- MUST be changed before any non-local
# deployment. Generate with: openssl rand -hex 32
LIVE_SERVER_SECRET_KEY=change-this-key-on-deployment

WEBHOOK_ALLOWED_IPS=
WEBHOOK_ALLOWED_HOSTS=
