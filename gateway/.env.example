# ==========================================================================
# Gateway -- component environment
#
# Every variable here maps 1:1 to a field in app/config.py:Settings. Copy to
# .env for standalone use (`docker compose up` in this directory, against a
# gateway you point at an already-running Plane/MCP/speech stack), or let the
# repo-root .env drive all of this when running the full stack.
# ==========================================================================

# development | production. In production, the gateway refuses to start if
# GATEWAY_API_TOKEN is still "change-me"/empty (see app/main.py).
ENVIRONMENT=development

GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8088
GATEWAY_API_TOKEN=change-me

# copilot | claude -- selects the agent CLI adapter. See app/agents/factory.py.
AGENT_CLI=copilot
AGENT_TIMEOUT_SECONDS=300
AGENT_MAX_CONCURRENT_REQUESTS=2

# ==========================================================================
# LLM (generic; translated into CLI-specific env vars by each adapter --
# see app/agents/copilot.py / claude.py). Changing LLM_MODEL never requires
# a source change.
# ==========================================================================
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com/anthropic
LLM_API_KEY=
LLM_MODEL=deepseek-v4-pro

# ==========================================================================
# Plane (filled in after the Phase 1 bootstrap -- see plane/README.md)
# ==========================================================================
PLANE_PUBLIC_URL=http://localhost:8080
PLANE_WORKSPACE_SLUG=
PLANE_API_KEY=
PLANE_USER_EMAIL=
PLANE_USER_ID=

# Server-to-server URL used ONLY by app/plane/health.py's direct health
# check (design rule 2.2 explicitly allows this one exception to "always go
# through MCP"). Matches Plane's own internal wiring -- see plane/README.md.
PLANE_INTERNAL_BASE_URL=http://api:8000

# Full Plane MCP endpoint, including the header-auth path. See
# plane-mcp/README.md "How authentication actually works" for why the path
# is /http/api-key/mcp and not the more commonly-documented /mcp.
PLANE_MCP_URL=http://plane-mcp:8211/http/api-key/mcp

# ==========================================================================
# Conversations
# ==========================================================================
CONVERSATION_CONTEXT_MESSAGES=10
# NOT DATABASE_URL -- when this stack runs standalone that doesn't matter,
# but the full stack shares one root .env with Plane, whose own compose
# file already uses DATABASE_URL for its Postgres connection string. Reusing
# it here silently overwrote Plane's value and crashed its api/migrator
# containers -- keep this name namespaced.
GATEWAY_DATABASE_URL=sqlite+aiosqlite:////data/gateway.db

# ==========================================================================
# Audio limits (app/api/query.py enforces both; duration via ffprobe,
# see app/speech/probe.py)
# ==========================================================================
MAX_AUDIO_SIZE_MB=25
MAX_AUDIO_DURATION_SECONDS=300

# ==========================================================================
# Speech-to-text (Whisper ASR Webservice)
# ==========================================================================
STT_URL=http://speech-stt:9000
STT_ENGINE=faster_whisper
STT_MODEL=small
# Leave blank for automatic language detection.
STT_LANGUAGE=

# ==========================================================================
# Text-to-speech (Kokoro-FastAPI)
# ==========================================================================
TTS_URL=http://speech-tts:8880
TTS_MODEL=kokoro
TTS_VOICE=af_heart
TTS_FORMAT=mp3
TTS_SPEED=1.0
TTS_CACHE_TTL_SECONDS=3600
TTS_CACHE_MAX_MB=500

# ==========================================================================
# Logging
# ==========================================================================
LOG_LEVEL=INFO
LOG_REQUEST_CONTENT=false
