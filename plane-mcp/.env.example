# ==========================================================================
# Plane MCP server -- component environment
# ==========================================================================

# Vendored source pin (also recorded in ../config/versions.env). Used only
# as a Docker image label; the actual pin is the git submodule commit under
# vendor/plane-mcp-server.
PLANE_MCP_VERSION=v0.3.2

# Internal, server-to-server URL for Plane's API. Set to the `api` service
# from the `plane` component, reachable because both components join the
# shared `plane-assistant` Docker network. Verified against Plane v1.4.2's
# own internal wiring (its `live` service uses this same URL).
PLANE_INTERNAL_BASE_URL=http://api:8000

# Fallback used only if PLANE_INTERNAL_BASE_URL is empty (e.g. pointing this
# component at Plane's hosted cloud instead of a self-hosted one). Leave
# blank for a normal self-hosted setup.
PLANE_BASE_URL=

# Optional prefix for the mounted HTTP routes. Leave blank unless this
# service sits behind a path-rewriting reverse proxy.
MCP_PATH_PREFIX=

# Logging. LOG_USER_INFO controls whether display names (PII) are logged;
# LOG_PAYLOADS controls whether full tool-call payloads are logged. Both
# default to false; enable only for local debugging.
LOG_USER_INFO=false
LOG_PAYLOADS=false

# The server unconditionally constructs its (unused, by us) OAuth transport
# at startup and refuses to boot without these set -- verified by actually
# running the container. We never use the OAuth route (only
# /http/api-key/mcp), so these are harmless non-secret placeholders. Do NOT
# put real OAuth credentials here; there is nothing in this stack that
# registers an OAuth client against this server.
PLANE_OAUTH_PROVIDER_CLIENT_ID=unused
PLANE_OAUTH_PROVIDER_CLIENT_SECRET=unused
PLANE_OAUTH_PROVIDER_BASE_URL=http://localhost:8211

# Whether to publish the MCP port to the host at all (see
# docker-compose.expose.yml). Never enable this on a host reachable from an
# untrusted network -- the API-key auth is per-request and does not require
# the port to be exposed for the gateway to use it (they share the internal
# Docker network already).
PLANE_MCP_EXPOSE_PORT=false
PLANE_MCP_HOST_PORT=8100
