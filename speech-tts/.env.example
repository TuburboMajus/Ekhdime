# ==========================================================================
# Kokoro-FastAPI -- component environment
# ==========================================================================

# Image tag, also recorded in ../config/versions.env. Do not use `latest`.
# Confirmed to exist for both the CPU and GPU images via `docker manifest
# inspect ghcr.io/remsky/kokoro-fastapi-{cpu,gpu}:v0.9.0`.
KOKORO_FASTAPI_VERSION=v0.9.0

# There is intentionally nothing else to configure here: voice, format, and
# speed are all per-request parameters on POST /v1/audio/speech (see
# README.md), and the model/voice packs are baked into the image rather than
# downloaded at runtime, so there's no cache path or API key to set. The
# gateway's own TTS_VOICE/TTS_FORMAT/TTS_SPEED defaults live in
# ../gateway/.env.example instead.
