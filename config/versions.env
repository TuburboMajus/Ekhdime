# ==========================================================================
# Pinned upstream versions
#
# Every component's docker-compose.yml reads its image tag from here (via
# `env_file: ../config/versions.env` or an equivalent `--env-file` on the
# `make` targets). Bump versions here deliberately -- see the root README's
# "Upgrade Strategy" section before changing any of these.
# ==========================================================================

# Plane Community Edition (self-hosted release compose + variables.env,
# taken from https://github.com/makeplane/plane/releases/<tag>)
PLANE_VERSION=v1.4.2

# Official Plane MCP server (Python + FastMCP), vendored as a git submodule
# pinned to this tag: https://github.com/makeplane/plane-mcp-server
PLANE_MCP_VERSION=v0.3.2

# Whisper ASR Webservice (faster-whisper engine)
# https://hub.docker.com/r/onerahmet/openai-whisper-asr-webservice/tags
WHISPER_ASR_VERSION=v1.10.0

# Kokoro-FastAPI (OpenAI-compatible TTS wrapper around Kokoro-82M)
# https://github.com/remsky/Kokoro-FastAPI/pkgs/container/kokoro-fastapi-cpu
KOKORO_FASTAPI_VERSION=v0.9.0

# Agent CLIs installed inside the gateway image (npm packages)
COPILOT_CLI_VERSION=1.0.83
CLAUDE_CODE_VERSION=2.1.270
