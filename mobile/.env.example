# ==========================================================================
# Mobile -- build-time configuration
#
# These only affect the reproducible Docker APK build (docker-compose.yml);
# they are NOT read at runtime by the app itself. The in-app server-setup
# screen is always the source of truth for which gateway to talk to -- see
# lib/screens/server_setup_screen.dart.
# ==========================================================================

# Exact Flutter SDK version to build with, also used as the Docker image tag
# (ghcr.io/cirruslabs/flutter:<version>). Keep in sync with `flutter --version`
# on your dev machine to avoid surprises.
FLUTTER_VERSION=3.32.7

# Optional: bakes a default gateway URL into the release build via
# --dart-define=DEFAULT_SERVER_URL=..., pre-filling (but not locking) the
# server-setup screen's URL field. Leave blank for a build with no
# preconfigured server -- the app works fine either way.
DEFAULT_SERVER_URL=
