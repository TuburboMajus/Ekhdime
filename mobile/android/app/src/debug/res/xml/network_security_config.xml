<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only network security config: allows cleartext (plain http://)
  traffic so the app can talk to a gateway running on localhost/LAN during
  development (e.g. http://10.0.2.2:8088 from the Android emulator). This
  file lives under src/debug so it is NOT included in release builds;
  release builds should use https and the platform default (cleartext
  disallowed).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
